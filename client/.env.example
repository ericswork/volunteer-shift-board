# Every VITE_ variable is bundled into the browser code, so never put secrets here
VITE_API_URL=http://localhost:4000
VITE_APP_TIMEZONE=Asia/Manila
# Firebase web app config (Project settings → Your apps); public by design
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
# Shared demo-account passwords, listed on purpose in the README
VITE_DEMO_VOLUNTEER_PASSWORD=demo-volunteer-password
VITE_DEMO_ADMIN_PASSWORD=demo-admin-password
