# Neon pooled connection string (host contains "-pooler"); used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Neon direct connection string; used by Prisma migrations and the seed
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Manila
PORT=4000
